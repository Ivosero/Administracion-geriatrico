# Dominio público apuntado al VPS de Hostinger (sin https://)
DOMAIN=serena.tudominio.com

# PostgreSQL: reemplazar por una contraseña larga y aleatoria
POSTGRES_DB=serena
POSTGRES_USER=serena
POSTGRES_PASSWORD=cambiar-por-clave-segura

# Desarrollo local opcional
DATABASE_URL=postgres://serena:cambiar-por-clave-segura@localhost:5432/serena
PORT=3001
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
